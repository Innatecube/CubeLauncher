{
  "build": {
    "beforeDevCommand": "pnpm turbo run dev --filter=@modrinth/app-frontend",
    "beforeBuildCommand": "pnpm turbo run build --filter=@modrinth/app-frontend",
    "frontendDist": "../app-frontend/dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "category": "Game",
    "copyright": "",
    "targets": "all",
    "externalBin": [],
    "icon": ["icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./nsis/hooks.nsi"
      }
    },
    "longDescription": "",
    "macOS": {
      "entitlements": "App.entitlements",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": [],
    "shortDescription": "",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "fileAssociations": [
      {
        "ext": ["mrpack"],
        "mimeType": "application/zip+mrpack"
      }
    ]
  },
  "productName": "Cube Launcher",
  "version": "0.9.204",
  "mainBinaryName": "Cube Launcher",
  "identifier": "CubeLauncher",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["modrinth"]
      },
      "mobile": []
    }
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "Cube Launcher",
        "width": 1280,
        "minHeight": 700,
        "minWidth": 1100,
        "visible": true,
        "zoomHotkeysEnabled": false,
        "decorations": false
      }
    ],
    "security": {
      "assetProtocol": {
        "scope": ["$APPDATA/caches/icons/*", "$APPCONFIG/caches/icons/*", "$CONFIG/caches/icons/*"],
        "enable": true
      },
      "capabilities": ["core", "plugins"],
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "https://api.github.com ipc: http://ipc.localhost https://modrinth.com https://*.modrinth.com https://*.posthog.com https://*.sentry.io https://api.mclo.gs https://api.curseforge.com https://account.ely.by https://*.ely.by",
        "font-src": ["https://cdn-raw.modrinth.com/fonts/inter/", "https://fonts.gstatic.com", "https://*.ely.by"],
        "img-src": "https: http://ely.by http://*.ely.by 'unsafe-inline' 'self' asset: http://asset.localhost blob: data:",
        "style-src": "'unsafe-inline' 'self' https://fonts.googleapis.com https://account.ely.by https://*.ely.by",
        "script-src": "https://*.posthog.com https://account.ely.by https://*.ely.by https://challenges.cloudflare.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/ https://hcaptcha.com https://*.hcaptcha.com 'self' 'unsafe-inline' 'unsafe-eval'",
        "frame-src": "https://www.youtube.com https://www.youtube-nocookie.com https://discord.com https://account.ely.by https://*.ely.by https://challenges.cloudflare.com https://hcaptcha.com https://*.hcaptcha.com https://www.google.com/recaptcha/ 'self'"
      }
    }
  }
}
